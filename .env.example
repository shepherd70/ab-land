# ab-land configuration. Copy to .env.local for overrides.
# No secrets required — all live data is open (OGL-Alberta).

# Base URL of the Alberta Energy GeoView ArcGIS REST services folder.
ARCGIS_BASE_URL=https://gis.energy.gov.ab.ca/arcgis/rest/services/Geoview

# Local SQLite database path (gitignored).
DB_PATH=./data/ab-land.sqlite

# Folder where you place lawfully obtained Altalis DIDs/DIDs+ files (gitignored).
ALTALIS_DIR=./data/altalis

# Ingest tuning.
INGEST_PAGE_SIZE=1000
INGEST_OUT_SR=4326

# Snapshot safety. A refresh aborts before publishing if a layer returns no
# valid rows or falls below this fraction of its current live row count.
INGEST_MIN_ROW_FRACTION=0.5
# Emergency override only after manually verifying an intentional large drop.
# INGEST_ALLOW_DESTRUCTIVE_REFRESH=1

# The header warns when the last complete mineral refresh is older than this.
DATA_STALE_AFTER_DAYS=8

# Optional: override the map basemap with a provider style URL (e.g. a keyed
# vector style). Defaults to a free, attributed OpenStreetMap raster basemap.
# NEXT_PUBLIC_MAP_STYLE=https://example.com/style.json
